# ══════════════════════════════════════════════════════════════════════════
# Marsad Platform — environment template
#
# Copy to .env.local (Next.js dev) and /etc/marsad/worker.env (VPS worker).
# NEVER commit real values. Secrets distribution per docs/architecture/06 §12:
#   Vercel project env vars  → Next.js runtime
#   /etc/marsad/worker.env   → VPS worker (root:root, 0600, systemd EnvironmentFile)
#   GitHub Environment       → CI/CD only
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase (project ref: yjsncnpbjuueaoeejrqj, ap-south-1) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://yjsncnpbjuueaoeejrqj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server-only. Next.js server runtime + worker (worker: Storage uploads only —
# DB access goes through the marsad_worker role below, 06 Revisions #1).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Non-Next runtimes (worker) that have no NEXT_PUBLIC_* convention may set:
SUPABASE_URL=https://yjsncnpbjuueaoeejrqj.supabase.co
# Worker Postgres connection — dedicated marsad_worker role via Supavisor
# session pooler (IPv4). No grants on billing.* or IAM key tables.
# When set, ops.llm_runs accounting inserts go direct over this connection
# (ops is never PostgREST-exposed); when unset (Next runtime), accounting
# uses the public.record_llm_run SECURITY DEFINER RPC via the service key.
SUPABASE_DB_URL=postgresql://marsad_worker:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ══════════════════════════════════════════════════════════════════════════
# LLM gateway (src/lib/llm) — provider-agnostic, env-only swaps (03 §1)
# ══════════════════════════════════════════════════════════════════════════

# Default provider for any role without an explicit LLM_ROLE_* entry.
# One of: anthropic | openrouter | ollama.
# DEFAULT POSTURE: Scenario B, open-weights via OpenRouter (06 §7.1, ~$10-20/mo).
LLM_PROVIDER=openrouter

# ── Provider block: Anthropic (native Messages API) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional override; defaults to https://api.anthropic.com/v1
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Provider block: OpenRouter (OpenAI-compatible) ──────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# Optional override; defaults to https://openrouter.ai/api/v1
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution headers OpenRouter asks for (defaults shown):
# LLM_OPENROUTER_REFERER=https://marsad.com
# LLM_OPENROUTER_TITLE=Marsad

# ── Provider block: Ollama / LM Studio / any OpenAI-compatible server ───────
# Local dev default. Production Scenario C points this at the owner's Mac via
# Tailscale (e.g. http://100.x.y.z:11434/v1) — dev-only until a tunnel exists.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama ignores auth; the placeholder keeps the header shape uniform.
# LLM_OLLAMA_API_KEY=ollama
# Health-probe budget before falling back off a dead local socket (03 §1.6.1):
# LLM_OLLAMA_HEALTH_TIMEOUT_MS=1500

# ── Role → provider:model map (optional; defaults live in src/lib/llm/roles.ts)
# Format: provider:model — the model part may itself contain colons (ollama tags).
# Unset roles use LLM_PROVIDER + that provider's default model for the role.
# LLM_ROLE_CLASSIFIER=openrouter:nousresearch/hermes-3-llama-3.1-70b
# LLM_ROLE_WRITER=openrouter:nousresearch/hermes-4-405b
# LLM_ROLE_EDITOR=openrouter:nousresearch/hermes-3-llama-3.1-70b
# LLM_ROLE_SUMMARIZER=openrouter:nousresearch/hermes-3-llama-3.1-70b
# LLM_ROLE_ANALYST_TAKE=openrouter:nousresearch/hermes-4-405b
# Hybrid upgrade posture (03 §1.5, quality-triggered — see 06 §7.1):
# LLM_ROLE_WRITER=anthropic:claude-sonnet-4-6
# LLM_ROLE_ANALYST_TAKE=anthropic:claude-sonnet-4-6
# All-local posture:
# LLM_ROLE_CLASSIFIER=ollama:qwen2.5:14b-instruct
# LLM_ROLE_WRITER=ollama:llama3.3:70b

# ── Per-role fallback chains (comma-separated provider:model, tried in order)
# Must span two model families (03 Revisions). Defaults in roles.ts.
# LLM_ROLE_WRITER_FALLBACK=openrouter:meta-llama/llama-3.3-70b-instruct,anthropic:claude-sonnet-4-6
# LLM_ROLE_CLASSIFIER_FALLBACK=openrouter:meta-llama/llama-3.3-70b-instruct,anthropic:claude-haiku-4-5

# Per-request timeout (ms) for chat completions (default 60000):
# LLM_TIMEOUT_MS=60000

# NOTE: the $60/mo LLM budget alarm + degrade ladder is NOT an env var — it is
# iam.global_switches key llm_budget_usd_month, consumed by the cost rollup.

# ══════════════════════════════════════════════════════════════════════════
# Worker (Hetzner CX22 VPS) — /etc/marsad/worker.env only
# ══════════════════════════════════════════════════════════════════════════

# Amazon SES — the platform's only sender from day one (06 Revisions #6)
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SES_FROM_EMAIL=wire@mail.marsad.com

# Cloudflare R2 — nightly encrypted pg_dump target (06 §8)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_BACKUPS=marsad-backups

# age public key for backup encryption (private key in owner's password manager)
AGE_BACKUP_PUBLIC_KEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Healthchecks.io ping URLs (one per scheduled job; comma-free single example)
HEALTHCHECKS_PING_URL_WORKER=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Sentry (both runtimes; free tier)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ══════════════════════════════════════════════════════════════════════════
# Billing (Next.js server runtime; trial is card-required)
# ══════════════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
