# marsad-worker environment. On the VPS this lives at /etc/marsad/worker.env
# (root:root 0600, loaded via systemd EnvironmentFile=). Locally: copy this
# file to worker/.env — `npm run dev` picks it up via --env-file-if-exists.
# Named env.example (no leading dot) so the root .gitignore's `.env*` pattern
# cannot swallow it — this file must ship in the clone (06 §12 contract).

# REQUIRED — marsad_worker role connection string.
# Production: Supavisor session pooler, IPv4 (06 Revisions #1), e.g.
#   postgresql://marsad_worker.yjsncnpbjuueaoeejrqj:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local (supabase start):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# OPTIONAL — used ONLY for Supabase Storage bucket uploads (raw-snapshots,
# filings-pdf). Documented least-privilege exception (06 Revisions #1).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL — Healthchecks.io worker-alive ping URL. Unset = pings disabled.
HEALTHCHECK_URL=

# OPTIONAL overrides
# WORKER_ID=vps-1
# LOG_LEVEL=debug
# HEARTBEAT_INTERVAL_MS=30000
# HEALTHCHECK_PING_INTERVAL_MS=300000
# SHUTDOWN_GRACE_MS=30000
